        <mxCell id="c_a2" value="- Data as a Product, дата-контракты&#10;- CQRS для потоковых витрин&#10;- Publisher / Subscriber между доменами&#10;- Outbox для надёжной публикации событий&#10;- FinOps как практика управления затратами" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;align=left;spacing=8;fillColor=#e7eef7;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="420" height="250" as="geometry"/></mxCell>
