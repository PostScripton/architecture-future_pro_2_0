        <mxCell id="c_a1" value="- Event-Driven Architecture&#10;- Data Mesh&#10;- Domain-Driven Design, bounded contexts&#10;- Anticorruption Layer для легаси&#10;- Self-service BI как принцип" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;align=left;spacing=8;fillColor=#eaf3e6;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="140" width="420" height="250" as="geometry"/></mxCell>
